<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StardewInteriorChanger</AssemblyName>
    <RootNamespace>StardewInteriorChanger</RootNamespace>
    <Version>0.1.0</Version>
    <ModFolderName>Stardew Interior Changer</ModFolderName>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableGameDebugging>false</EnableGameDebugging>
    <EnableHarmony>true</EnableHarmony>
    <BundleExtraAssemblies>ThirdParty</BundleExtraAssemblies>
    <IgnoreModFilePatterns>\.pdb$</IgnoreModFilePatterns>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\smapi-internal\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Content Include="assets\views\**\*.sml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\StardewUI.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <ProjectReference Include="..\StardewInteriorChanger.Core\StardewInteriorChanger.Core.csproj" />
  </ItemGroup>
</Project>
